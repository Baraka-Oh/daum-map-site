# Kakao Developers(developers.kakao.com) > 내 애플리케이션 > 앱 만들기 후
# [앱 설정 > 요약 정보]에서 확인 가능한 키를 입력하세요. (앱 하나에서 두 키 모두 발급됨)

# JavaScript 키 - 프론트엔드에서 지도를 그릴 때 사용
# [플랫폼] 설정에 사이트 도메인 등록 필요 (예: http://localhost:3000)
KAKAO_JS_KEY=여기에_JavaScript_키_입력

# REST API 키 - 백엔드에서 주소 검색(Geocoding) API 호출 시 사용
KAKAO_REST_API_KEY=여기에_REST_API_키_입력

# VWorld(www.vworld.kr) 인증키 - 필지 경계/토지특성정보 조회용
VWORLD_KEY=여기에_VWorld_인증키_입력
VWORLD_DOMAIN=localhost:3000

PORT=3000
